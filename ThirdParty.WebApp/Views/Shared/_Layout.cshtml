<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Third-Party Payment Agency</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/thirdparty.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-tp">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Collection" asp-action="Lookup">
                    <i class="bi bi-building-fill-check text-cyan fs-4"></i>
                    QuickPay Counter Collection Agency
                    <span class="agent-badge">AGENT PORTAL</span>
                </a>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="text-light small"><i class="bi bi-person-badge text-info"></i> Agent ID: <strong>AGENT-5501</strong></span>
                    <a asp-controller="Collection" asp-action="Lookup" class="btn btn-outline-info btn-sm rounded-pill"><i class="bi bi-search me-1"></i> New Lookup</a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="mt-auto py-3 bg-dark border-top border-secondary text-center text-muted small">
        <div class="container">
            &copy; 2026 Authorized Third-Party Payment Collector — Integrated with NWSDB.Api &amp; Bank.Api
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
