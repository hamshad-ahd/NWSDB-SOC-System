@model IEnumerable<NWSDB.Website.Models.ViewModels.BillDto>
@{
    ViewData["Title"] = "Bill Statement History";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-file-earmark-spreadsheet-fill me-2"></i>Bill History</h2>
            <p class="text-muted">Review all past and present water utility bill statements.</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Bill Number</th>
                            <th>Month</th>
                            <th>Units Used</th>
                            <th>Total Amount</th>
                            <th>Paid Amount</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var bill in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@bill.BillNumber</td>
                                    <td>@bill.BillingMonth</td>
                                    <td>@bill.UnitsUsed Units</td>
                                    <td class="fw-semibold">Rs. @bill.BillAmount.ToString("N2")</td>
                                    <td class="text-success fw-semibold">Rs. @bill.PaidAmount.ToString("N2")</td>
                                    <td>@bill.DueDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (bill.Status == "Paid")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Paid</span>
                                        }
                                        else if (bill.Status == "Partially Paid")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Partially Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (bill.Status != "Paid")
                                        {
                                            <a asp-controller="Payment" asp-action="PayCard" asp-route-billNumber="@bill.BillNumber" class="btn btn-sm btn-primary rounded-pill px-3">
                                                Pay Now
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-check-circle-fill text-success me-1"></i>Settled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No bill statements found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
