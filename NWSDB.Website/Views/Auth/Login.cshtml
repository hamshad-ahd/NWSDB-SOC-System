@model NWSDB.Website.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Customer Verification & Login";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="glass-card shadow-lg">
            <div class="text-center mb-4">
                <i class="bi bi-droplet-half text-info display-4"></i>
                <h3 class="fw-bold mt-2">NWSDB Customer Portal</h3>
                <p class="text-muted small">Verify your account number and customer name to access billing &amp; services</p>
            </div>

            @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
            {
                <div class="alert alert-danger rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label asp-for="AccountNumber" class="form-label text-light fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person-vcard"></i></span>
                        <input asp-for="AccountNumber" class="form-control bg-dark text-light border-secondary" placeholder="e.g. NWSDB-1001" />
                    </div>
                    <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CustomerName" class="form-label text-light fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-person font-monospace"></i></span>
                        <input asp-for="CustomerName" class="form-control bg-dark text-light border-secondary" placeholder="e.g. Kavindu Perera" />
                    </div>
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-nwsdb-primary w-100 py-2">
                    <i class="bi bi-shield-check me-2"></i> Verify Customer &amp; Access Dashboard
                </button>
            </form>

            <div class="mt-4 pt-3 border-top border-secondary text-center">
                <small class="text-muted">Demo Verification Credentials:</small>
                <div class="badge bg-secondary d-block mt-1 p-2 font-monospace">
                    Account: <strong>NWSDB-1001</strong> | Name: <strong>Kavindu Perera</strong>
                </div>
            </div>
        </div>
    </div>
</div>
