@model NWSDB.Website.Models.ViewModels.CustomerDto
@{
    ViewData["Title"] = "Account Profile Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="glass-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0"><i class="bi bi-person-badge text-info me-2"></i>Account Details</h3>
                <span class="badge bg-primary px-3 py-2 font-monospace">@Model.AccountNumber</span>
            </div>

            <div class="row g-3 text-light">
                <div class="col-md-6">
                    <div class="p-3 border border-secondary rounded-3 bg-dark">
                        <small class="text-muted d-block text-uppercase">Full Name</small>
                        <strong class="fs-5">@Model.Name</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 border border-secondary rounded-3 bg-dark">
                        <small class="text-muted d-block text-uppercase">Account Number</small>
                        <strong class="fs-5 font-monospace text-info">@Model.AccountNumber</strong>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="p-3 border border-secondary rounded-3 bg-dark">
                        <small class="text-muted d-block text-uppercase">Registered Service Address</small>
                        <span>@Model.Address</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 border border-secondary rounded-3 bg-dark">
                        <small class="text-muted d-block text-uppercase">Phone Number</small>
                        <span>@Model.Phone</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 border border-secondary rounded-3 bg-dark">
                        <small class="text-muted d-block text-uppercase">Email Address</small>
                        <span>@Model.Email</span>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
                <a asp-controller="Bill" asp-action="CurrentBill" class="btn btn-nwsdb-primary">Current Bill &rarr;</a>
            </div>
        </div>
    </div>
</div>
